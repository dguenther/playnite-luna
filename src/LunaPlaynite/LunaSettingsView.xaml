<UserControl x:Class="LunaPlaynite.LunaSettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Foreground="{DynamicResource TextBrush}">
    <StackPanel Margin="16">
        <Label Content="Subscription type" Target="{Binding ElementName=SubscriptionTypeBox}" Padding="0"/>
        <ComboBox x:Name="SubscriptionTypeBox" Margin="0,6,0,0" Width="220" HorizontalAlignment="Left"
            ItemsSource="{Binding SubscriptionTypes}"
            SelectedItem="{Binding SubscriptionType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
        <CheckBox x:Name="InstalledBox" Margin="0,16,0,0" Content="Mark Luna games as installed"
            IsChecked="{Binding MarkGamesInstalled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
        <CheckBox x:Name="RefreshOnLibraryUpdateBox" Margin="0,10,0,0" Content="Update catalog when Playnite updates libraries"
            IsChecked="{Binding RefreshOnLibraryUpdate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
        <CheckBox x:Name="TagExpiredGamesBox" Margin="0,10,0,0" Content="Tag games no longer available on Luna as expired"
            IsChecked="{Binding TagExpiredGames, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
        <CheckBox x:Name="ImportNewGamesBox" Margin="0,10,0,0" Content="Add newly added games in my subscription to the library"
            IsChecked="{Binding ImportNewGames, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
        <CheckBox x:Name="RemoveUnplayedGamesBox" Margin="0,10,0,0" Content="Remove expired games that have not been played"
            IsChecked="{Binding RemoveUnplayedGames, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
    </StackPanel>
</UserControl>
