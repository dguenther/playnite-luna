<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net462</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>LunaPlaynite</AssemblyName>
    <RootNamespace>LunaPlaynite</RootNamespace>
    <Version>0.1.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="PlayniteSDK" Version="6.17.0" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net462" Version="1.0.3" PrivateAssets="all" />
    <ProjectReference Include="../LunaCatalogBrowser/LunaCatalogBrowser.csproj" />
    <Reference Include="System.Net.Http" />
    <None Update="extension.yaml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- Playnite supplies the SDK and Newtonsoft.Json 10.0.3 at runtime. -->
  <Target Name="StageExtension" AfterTargets="Build">
    <ItemGroup>
      <ExtensionFiles Include="$(TargetPath);$(TargetDir)LunaCatalog.dll;$(TargetDir)LunaCatalogBrowser.dll;$(ProjectDir)extension.yaml;$(ProjectDir)../../LICENSE;$(ProjectDir)THIRD-PARTY-NOTICES.txt" />
    </ItemGroup>
    <RemoveDir Directories="$(TargetDir)extension" />
    <MakeDir Directories="$(TargetDir)extension" />
    <Copy SourceFiles="@(ExtensionFiles)" DestinationFolder="$(TargetDir)extension" />
  </Target>
</Project>
